NODE_ENV=development
PORT=3000
DATA_DIR=./data
# Optional overrides. If unset, both paths are derived from DATA_DIR.
# DB_PATH=./data/openlearning.sqlite
# MEDIA_ROOT=./data/course-media
MAX_UPLOAD_BYTES=2147483648
REQUEST_TIMEOUT_MS=300000
SESSION_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
# Required for the first-run setup wizard. Generate a private random value of at least 32 characters.
SETUP_TOKEN=
TRUST_PROXY=false
