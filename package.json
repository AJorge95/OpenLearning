{
  "name": "openlearning-platform",
  "version": "0.181.0",
  "private": true,
  "type": "module",
  "description": "A lightweight, self-hosted learning platform for courses, lessons, and quizzes.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "dev": "node scripts/dev.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --test",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "version:major": "node scripts/versioning.js major",
    "start": "node scripts/start.js",
    "db:migrate": "node server/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
